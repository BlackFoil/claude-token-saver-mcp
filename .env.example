# Ollama settings
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_NUM_GPU=999

# Override tier model (optional)
# CTS_TIER1_MODEL=phi4-mini:latest
# CTS_TIER2_MODEL=qwen2.5-coder:7b
# CTS_TIER3_MODEL=qwen2.5-coder:32b

# Override cloud pricing (optional, $/1M tokens)
# CTS_CLOUD_INPUT_PRICE=3.0
# CTS_CLOUD_OUTPUT_PRICE=15.0

# Logging
CTS_LOG_LEVEL=info
