# Ollama settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_GPU=999

# Tier override (optional: 1, 2, 3)
# TIER_OVERRIDE=2

# Override tier model (optional)
# MODEL_OVERRIDE=qwen2.5-coder:7b

# Queue settings
# QUEUE_MAX_SIZE=10
# QUEUE_TIMEOUT_MS=60000

# Ollama timeout (optional, ms)
# OLLAMA_TIMEOUT_MS=90000

# Override cloud pricing (optional, $/1M tokens)
# CLOUD_INPUT_PRICE_PER_MTOKEN=3.0
# CLOUD_OUTPUT_PRICE_PER_MTOKEN=15.0

# Dynamic model selector (v0.2.0)
# MODEL_SELECTOR_ENABLED=true
# MODEL_PREFER_QUALITY=false
# MAX_SIMULTANEOUS_MODELS=auto
# PRELOAD_KEEP_ALIVE=-1

# Logging
LOG_LEVEL=info
